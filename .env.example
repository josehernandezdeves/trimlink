# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Usado por el Server Action de creación de links y por el middleware
# para hashear la IP antes de descartarla (nunca se persiste en crudo)
IP_HASH_SALT=cambia-esto-por-una-cadena-aleatoria-larga

# URL pública del sitio (usada para componer los links cortos: https://tudominio.com/abc123)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
